# ================================
# TradeBot runtime configuration
# Copy to .env and fill in values
# ================================

# ── Deployment ──────────────────────────────────────────────────────────────
NODE_ENV=development
# public_saas | private_cloud | on_prem
DEPLOYMENT_TIER=on_prem
PORT=5000

# ── Session ──────────────────────────────────────────────────────────────────
# Must be 32+ chars in production
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-32+char-secret

# ── Database ─────────────────────────────────────────────────────────────────
# Add ?sslmode=require for Railway / hosted PostgreSQL
DATABASE_URL=postgres://user:password@host:5432/dbname

# ── Security ─────────────────────────────────────────────────────────────────
# Agent authentication key (kiwoom-agent.py <-> server)
AGENT_KEY=replace-with-32+char-agent-key

# AES-256-GCM key for encrypting Kiwoom API keys stored in DB
# WARNING: If this key changes, all stored API keys become unreadable. Back it up!
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-64-char-hex-string

# ── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# LLM backend selection (default: openai — 미설정 시 기존 OpenAI 경로 그대로 동작)
#   openai      = OpenAI API (기본, OPENAI_API_KEY 사용)
#   claude_api  = Anthropic API (ANTHROPIC_API_KEY 필요 + npm i @anthropic-ai/sdk)
#   claude_cli  = 서버에 인증된 Claude Code CLI 구독 사용 (claude -p, 추가 키 불필요)
LLM_PROVIDER=openai
# ANTHROPIC_API_KEY=           # claude_api 모드에서만 필요
# CLAUDE_MODEL=claude-sonnet-4-6  # claude_api / claude_cli 기본 모델 override

# ── Kiwoom ───────────────────────────────────────────────────────────────────
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_APP_KEY_REAL=
KIWOOM_APP_SECRET_REAL=
KIWOOM_APP_KEY_MOCK=
KIWOOM_APP_SECRET_MOCK=

# ── SaaS billing (public_saas only) ──────────────────────────────────────────
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# ── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── CORS (comma-separated extra allowed origins beyond localhost) ─────────────
# Example: https://app.tradebot.kr,https://staging.tradebot.up.railway.app
ALLOWED_ORIGINS=
